{
  "name": "openzl-cli",
  "version": "0.1.0",
  "description": "OpenZL CLI - High-performance compression tool",
  "main": "index.js",
  "bin": {
    "zli": "./bin/zli"
  },
  "optionalDependencies": {
    "@openzl/cli-darwin-arm64": "file:./build/binaries/darwin-arm64",
    "@openzl/cli-darwin-x64": "file:./build/binaries/darwin-x64",
    "@openzl/cli-linux-arm64": "file:./build/binaries/linux-arm64",
    "@openzl/cli-linux-x64": "file:./build/binaries/linux-x64",
    "@openzl/cli-win32-x64": "file:./build/binaries/win32-x64"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "postinstall": "node scripts/postinstall.js",
    "test": "zli --version"
  },
  "files": [
    "bin",
    "build/binaries",
    "scripts/postinstall.js",
    "README.md"
  ],
  "os": ["darwin", "linux", "win32"],
  "cpu": ["x64", "arm64"],
  "keywords": [
    "openzl",
    "compression",
    "cli",
    "zli",
    "binary"
  ],
  "author": "OpenZL Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openzl/openzl.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
