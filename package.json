{
  "name": "@openzl/express",
  "version": "0.1.0",
  "description": "Express middleware for compressing JSON responses using OpenZL",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "ts-node example/server.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openzl",
    "compression",
    "express",
    "middleware",
    "api",
    "json",
    "performance"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "dependencies": {
    "@openzl/cli": "file:./@openzl-cli"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "express": "^4.18.2",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/openzl-express.git"
  }
}

