{
  "name": "openzl-express",
  "version": "0.2.0",
  "description": "Express middleware for compressing JSON responses using OpenZL, with automatic gzip fallback",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "ts-node example/server.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openzl",
    "compression",
    "express",
    "middleware",
    "api",
    "json",
    "performance",
    "gzip"
  ],
  "author": "Amir Jahanshahi",
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "optionalDependencies": {
    "@amirja811/openzl-cli": "^0.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "express": "^4.18.2",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvinja81/openzl-npm.git"
  },
  "bugs": {
    "url": "https://github.com/alvinja81/openzl-npm/issues"
  },
  "homepage": "https://github.com/alvinja81/openzl-npm#readme"
}
